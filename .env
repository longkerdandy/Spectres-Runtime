# Base development configuration for Spectres Runtime.
# Keep base env files free of secrets. Put real credentials and private overrides in .env.local.
# Settings loads .env followed by .env.local; values in the local file take precedence.

# PostgreSQL persistence for Runtime data, including pgvector-backed features.
# Set DB_USER and DB_PASS in .env.local. Docker Compose must receive both env files.
DB_HOST=127.0.0.1
DB_PORT=5532
DB_USER=replace-in-local-file
DB_PASS=replace-in-local-file
DB_DATABASE=spectres_runtime

# AgentOS HTTP server bind address and port.
AGENT_OS_HOST=0.0.0.0
AGENT_OS_PORT=7777

# Comma-separated browser origins allowed to call the Runtime API.
# Leave empty to allow only Agno platform domains; CORS is not a security boundary.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional Tavily web search integration.
# Replace the placeholder in .env.local to enable real searches.
TAVILY_API_KEY=FAKE_API_KEY

# Team Leader LLM connection. Use openai for OpenAI-compatible APIs or gemini for Google AI Studio.
# Configure real model credentials in .env.local. BASE_URL is unused with gemini.
# Optional numeric and header settings may be left empty to use provider defaults.
TEAM_LEADER_LLM_PROVIDER=openai
TEAM_LEADER_LLM_MODEL=FAKE_MODEL
TEAM_LEADER_LLM_BASE_URL=FAKE_BASE_URL
TEAM_LEADER_LLM_API_KEY=FAKE_API_KEY
TEAM_LEADER_LLM_TEMPERATURE=1
TEAM_LEADER_LLM_MAX_COMPLETION_TOKENS=4096
TEAM_LEADER_LLM_EXTRA_HEADERS={}

# Structured JSONL file logging and stdout logging.
# LOG_FORMAT controls stdout; daily JSONL files are stored under LOG_DIR.
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# Agno's in-process AgentOS scheduler.
# SCHEDULER_BASE_URL must match the running AgentOS address.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=15
SCHEDULER_BASE_URL=http://127.0.0.1:7777

# ETF Grid market-data credentials and tracked portfolio.
# The API key is needed for candle synchronization, not for Runtime startup.
ETF_GRID_FTSHARE_API_KEY=FAKE_API_KEY
ETF_GRID_PORTFOLIO=[{"symbol":"513330.XSHG","name":"恒生互联网ETF","per_grid_amount":10000,"max_grids":15},{"symbol":"513120.XSHG","name":"港股创新药ETF","per_grid_amount":10000,"max_grids":8},{"symbol":"513530.XSHG","name":"港股通红利ETF","per_grid_amount":10000,"max_grids":7,"gate":{"index_code":"930914","metric":"dyr","threshold":0.2,"block_when":"below"}}]

# ETF Grid candle history, grid sizing, and synchronization schedule.
# Cron uses the configured IANA timezone; retries apply to refresh endpoint 5xx responses.
ETF_GRID_CANDLE_LOOKBACK_DAYS=90
ETF_GRID_BACKFILL_START_DATE=2021-01-01
ETF_GRID_GRID_STEP=0.05
ETF_GRID_SYNC_SCHEDULE_ENABLED=true
ETF_GRID_SYNC_CRON=0 9 * * 1,5
ETF_GRID_SYNC_TIMEZONE=Asia/Shanghai
ETF_GRID_SYNC_MAX_RETRIES=2
ETF_GRID_SYNC_RETRY_DELAY_SECONDS=300

# Self-hosted Logto service and its database on the shared PostgreSQL instance.
# Keep the admin console restricted to trusted networks.
LOGTO_DB_DATABASE=logto
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# JWT verification through Agno AgentOS.
# Export Logto's OIDC JWKS to the configured local path; audience and issuer must match Logto.
JWT_JWKS_FILE=/absolute/path/to/logto-jwks.json
JWT_AUDIENCE=https://spectres.runtime/api
JWT_ISSUER=http://localhost:3001/oidc
