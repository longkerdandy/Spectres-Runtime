# Test environment configuration for Spectres Runtime.
# This file is committed to version control and used by pytest.
# It configures the test suite to use Zhipu BigModel's free GLM model instead of the production LLM.
# The API key is intentionally left empty; provide it via .env.test.local (gitignored).

# Test PostgreSQL database on the shared local PostgreSQL instance.
# Set DB_USER and DB_PASS in .env.test.local.
DB_HOST=127.0.0.1
DB_PORT=5532
DB_USER=replace-in-local-file
DB_PASS=replace-in-local-file
DB_DATABASE=spectres_runtime_test

# AgentOS settings used by application tests.
AGENT_OS_HOST=127.0.0.1
AGENT_OS_PORT=7777

# Test CORS and optional web-search configuration.
CORS_ALLOWED_ORIGINS=
TAVILY_API_KEY=

# Test LLM configuration. Real credentials belong in .env.test.local or CI secrets.
# CI may override the provider and model; BASE_URL is unused with gemini.
TEAM_LEADER_LLM_PROVIDER=openai
TEAM_LEADER_LLM_MODEL=FAKE_MODEL
TEAM_LEADER_LLM_BASE_URL=FAKE_BASE_URL
TEAM_LEADER_LLM_API_KEY=FAKE_API_KEY
TEAM_LEADER_LLM_TEMPERATURE=1
TEAM_LEADER_LLM_MAX_COMPLETION_TOKENS=4096
TEAM_LEADER_LLM_EXTRA_HEADERS={}

# Test logging configuration.
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# Keep background scheduler polling disabled by default in tests.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL=15
SCHEDULER_BASE_URL=http://127.0.0.1:7777

# ETF Grid test configuration. Set the real API key in .env.test.local or CI secrets.
ETF_GRID_FTSHARE_API_KEY=FAKE_API_KEY
ETF_GRID_PORTFOLIO=[{"symbol":"513330.XSHG","name":"恒生互联网ETF","per_grid_amount":10000,"max_grids":15},{"symbol":"513120.XSHG","name":"港股创新药ETF","per_grid_amount":10000,"max_grids":8},{"symbol":"513530.XSHG","name":"港股通红利ETF","per_grid_amount":10000,"max_grids":7,"gate":{"index_code":"930914","metric":"dyr","threshold":0.2,"block_when":"below"}}]
ETF_GRID_CANDLE_LOOKBACK_DAYS=90
ETF_GRID_BACKFILL_START_DATE=2021-01-01
ETF_GRID_GRID_STEP=0.05
ETF_GRID_SYNC_SCHEDULE_ENABLED=false
ETF_GRID_SYNC_CRON=0 9 * * 1,5
ETF_GRID_SYNC_TIMEZONE=Asia/Shanghai
ETF_GRID_SYNC_MAX_RETRIES=2
ETF_GRID_SYNC_RETRY_DELAY_SECONDS=300

# Logto settings used when Docker Compose starts the test services.
LOGTO_DB_DATABASE=logto
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# Leave JWT settings unset in the base test environment.
# Authentication tests create isolated application instances with their own test keys.
