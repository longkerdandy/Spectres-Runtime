# Test environment configuration for Spectres Runtime.
# This file is committed to version control and used by pytest.
# It configures the test suite to use Zhipu BigModel's free GLM model instead of the production LLM.
# The API key is intentionally left empty; provide it via .env.test.local (gitignored).

# Database configuration (PostgreSQL)
# Used as the persistent data store for the Runtime, including pgvector for the knowledge base and long-term memory.
DB_HOST=localhost                  # Hostname or IP address of the PostgreSQL server.
DB_PORT=5532                       # Port number of the PostgreSQL server.
DB_USER=FAKE_USERNAME              # Username for database authentication.
DB_PASS=FAKE_PASSWORD              # Password for database authentication.
DB_DATABASE=spectres_runtime_test  # Name of the database to connect to.

# AgentOS server configuration (required)
# Controls the bind address and port when running AgentOS directly (e.g., python -m spectres.main).
AGENT_OS_HOST=0.0.0.0         # Interface to bind. Use 127.0.0.1 to accept local connections only.
AGENT_OS_PORT=7777            # Port for the AgentOS HTTP server.

# CORS configuration (required)
# Allowed cross-origin callers of the Runtime API (browser convenience, not a security boundary).
CORS_ALLOWED_ORIGINS=http://localhost:3000  # Comma-separated list of origins.

# Web search configuration
# Tavily Search API key (https://www.tavily.com); basic depth (1 credit/search, free tier 1,000/month).
TAVILY_API_KEY=FAKE_API_KEY   # Optional; replace with a real key to enable web search.

# Team Leader Agent configuration (OpenAI-compatible API)
# Used to connect the Team Leader Agent to an open-source or self-hosted LLM through an OpenAI-compatible endpoint (e.g., vLLM, Ollama, LiteLLM proxy).
TEAM_LEADER_LLM_MODEL=glm-4.7-flash                        # Free model on BigModel (GLM-4.7-Flash is permanently free).
TEAM_LEADER_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # Zhipu BigModel (GLM), reachable from CN and CI; alternative: https://api.z.ai/api/paas/v4 (z.ai intl, separate account/key). GitHub Models was retired 2026-07-30.
TEAM_LEADER_LLM_API_KEY=FAKE_API_KEY        # API key for the Team Leader Agent's OpenAI-compatible endpoint (leave empty if not required).
TEAM_LEADER_LLM_TEMPERATURE=0.5             # Sampling temperature (0.0 - 2.0). Lower = more deterministic.
TEAM_LEADER_LLM_MAX_COMPLETION_TOKENS=4096  # Maximum tokens to generate in a single response.
TEAM_LEADER_LLM_EXTRA_HEADERS={"User-Agent":"Spectres-Runtime/0.2.1"}  # Optional JSON object with extra HTTP headers for the LLM API.

# ETF Grid extension configuration
# Market data sync via the FTShare SDK; the bare FTSHARE_API_KEY env var is also honored.
ETF_GRID_FTSHARE_API_KEY=FAKE_API_KEY  # Optional; required only when invoking candle sync (scripts/jobs), not for Runtime startup.
# Optional JSON array of {"symbol","name","per_grid_amount","max_grids"}; the value below is the built-in default (current 3-ETF portfolio).
ETF_GRID_PORTFOLIO=[{"symbol":"513330.XSHG","name":"恒生互联网ETF","per_grid_amount":10000,"max_grids":15},{"symbol":"513120.XSHG","name":"港股创新药ETF","per_grid_amount":10000,"max_grids":8},{"symbol":"513530.XSHG","name":"港股通红利ETF","per_grid_amount":10000,"max_grids":7}]
ETF_GRID_CANDLE_LOOKBACK_DAYS=90            # Trailing self-healing re-fetch window in days (covers MA60; qfq dividends recompute history).
ETF_GRID_BACKFILL_START_DATE=2021-01-01     # First-full-backfill start date for symbols with no local candles.
ETF_GRID_GRID_STEP=0.05                     # Grid step as a fraction (0.05 = 5%).
