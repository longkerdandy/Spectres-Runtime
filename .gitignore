# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Packaging / distribution
build/
dist/
*.egg-info/
*.egg

# Test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments
.venv/
env/
venv/

# Local environment overrides (.env.example / .env.test are committed on purpose)
.env
.env.test.local

# Tool caches
.mypy_cache/
.ruff_cache/

# Editors
.idea/
*.local

# Kimi Code local settings
.kimi-code/

# Runtime structured logs
logs/

# Logto OIDC public keys (JWT_JWKS_FILE) exported from the local Logto instance —
# a per-environment generated artifact, re-created via the runbook in
# docs/architecture/authentication.md; never committed.
docker/logto/jwks.json
